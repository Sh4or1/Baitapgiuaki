@model IEnumerable<Dish_BIT240097>
@{var vi=ViewBag.IsVi==true;}
<div class="page-head"><div><p class="eyebrow">@(vi?"QUẢN TRỊ NHÀ HÀNG":"RESTAURANT ADMINISTRATION")</p><h1>@(vi?"Quản lý món ăn":"Dish Management")</h1><p class="muted">@(vi?"Tìm kiếm, lọc và quản lý thực đơn":"Search, filter and manage your menu")</p></div><a class="btn primary" asp-action="Create">＋ @(vi?"Thêm món":"Add dish")</a></div>
@if(ViewBag.FilterError!=null){<div class="alert">@ViewBag.FilterError</div>}
<form method="get" class="filters"><input name="search" value="@ViewBag.Search" placeholder="@(vi?"Tên món ăn...":"Search dish name...")"/><select name="categoryId"><option value="">@(vi?"Tất cả loại":"All categories")</option>@foreach(var c in (SelectList)ViewBag.Categories){<option value="@c.Value" selected="@(c.Value==Convert.ToString(ViewBag.CategoryId))">@c.Text</option>}</select><select name="available"><option value="">@(vi?"Mọi trạng thái":"All statuses")</option><option value="true" selected="@(Convert.ToString(ViewBag.Available)=="True")">@(vi?"Đang bán":"Available")</option><option value="false" selected="@(Convert.ToString(ViewBag.Available)=="False")">@(vi?"Ngừng bán":"Unavailable")</option></select><input type="number" min="0" step="0.01" name="minPrice" value="@ViewBag.MinPrice" placeholder="@(vi?"Giá từ":"Min price")"/><input type="number" min="0" step="0.01" name="maxPrice" value="@ViewBag.MaxPrice" placeholder="@(vi?"Giá đến":"Max price")"/><select name="sort"><option value="">@(vi?"Tên A–Z":"Name A–Z")</option><option value="price_asc" selected="@(ViewBag.Sort=="price_asc")">@(vi?"Giá tăng":"Price ↑")</option><option value="price_desc" selected="@(ViewBag.Sort=="price_desc")">@(vi?"Giá giảm":"Price ↓")</option><option value="time_asc" selected="@(ViewBag.Sort=="time_asc")">@(vi?"Thời gian chế biến":"Prep time ↑")</option></select><button class="btn primary" type="submit">@(vi?"Lọc":"Apply")</button><a class="btn" asp-action="Index">@(vi?"Xóa lọc":"Reset")</a></form>
<div class="table-wrap"><table><thead><tr><th>@(vi?"Món ăn":"Dish")</th><th>@(vi?"Loại":"Category")</th><th>@(vi?"Giá":"Price")</th><th>@(vi?"Thời gian":"Prep time")</th><th>@(vi?"Trạng thái":"Status")</th><th>@(vi?"Thao tác":"Actions")</th></tr></thead><tbody>
@foreach(var d in Model){var thumb=d.Images.FirstOrDefault(x=>x.IsThumbnail)??d.Images.FirstOrDefault();<tr><td><div class="dish-cell">@if(thumb!=null){<img class="thumb" src="@thumb.ImageUrl" alt="@d.Name"/>}else{<div class="thumb placeholder">🍽</div>}<div><strong>@d.Name</strong><small>@(string.IsNullOrWhiteSpace(d.Description)?"—":d.Description)</small></div></div></td><td>@d.Category?.Name</td><td>@d.Price.ToString("N0") đ</td><td><span class="pill">@(d.PreparationTime<=15?(vi?"Nhanh":"Quick"):(vi?"Thông thường":"Regular"))</span><small>@d.PreparationTime min</small></td><td><span class="status @(d.IsAvailable?"on":"off")">@(d.IsAvailable?(vi?"Đang bán":"Available"):(vi?"Ngừng bán":"Unavailable"))</span></td><td class="actions"><a asp-action="Details" asp-route-id="@d.Id">@(vi?"Chi tiết":"Details")</a><a asp-action="Edit" asp-route-id="@d.Id">@(vi?"Sửa":"Edit")</a><a asp-action="Delete" asp-route-id="@d.Id">@(vi?"Xóa":"Delete")</a></td></tr>}
@if(!Model.Any()){<tr><td colspan="6" class="empty">@(vi?"Không tìm thấy món ăn phù hợp.":"No dishes match your filters.")</td></tr>}
</tbody></table></div>