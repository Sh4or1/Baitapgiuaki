@model Dish_BIT240097
<div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="field"><label asp-for="Name">@((Context.Session.GetString("lang")=="vi")?"Tên món ăn":"Dish name")</label><input asp-for="Name"/><span asp-validation-for="Name" class="validation"></span></div><div class="field"><label asp-for="DishCategoryId">@((Context.Session.GetString("lang")=="vi")?"Loại món":"Category")</label><select asp-for="DishCategoryId" asp-items="ViewBag.Categories"><option value="">-- Select category --</option></select><span asp-validation-for="DishCategoryId" class="validation"></span></div><div class="field"><label asp-for="Price">@((Context.Session.GetString("lang")=="vi")?"Giá (VND)":"Price (VND)")</label><input asp-for="Price" type="number" min="0.01" step="0.01"/><span asp-validation-for="Price" class="validation"></span></div><div class="field"><label asp-for="PreparationTime">@((Context.Session.GetString("lang")=="vi")?"Thời gian chế biến (phút)":"Preparation time (minutes)")</label><input asp-for="PreparationTime" type="number" min="1"/><span asp-validation-for="PreparationTime" class="validation"></span></div><div class="field full"><label asp-for="Description">@((Context.Session.GetString("lang")=="vi")?"Mô tả":"Description")</label><textarea asp-for="Description" rows="3"></textarea></div><label class="check"><input asp-for="IsAvailable"/> @((Context.Session.GetString("lang")=="vi")?"Đang bán":"Available for sale")</label></div><div class="form-actions"><button class="btn primary" type="submit">@((Context.Session.GetString("lang")=="vi")?"Lưu":"Save")</button><a class="btn" asp-action="Index">@((Context.Session.GetString("lang")=="vi")?"Hủy":"Cancel")</a></div>