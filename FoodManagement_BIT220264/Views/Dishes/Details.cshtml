@model Dish_BIT220264
@{var vi=Context.Session.GetString("lang")=="vi";}
<div class="page-head"><div><p class="eyebrow">DISH DETAILS</p><h1>@Model.Name</h1><p class="muted">@Model.Category?.Name</p></div><a class="btn" asp-action="Index">← @(vi?"Quay lại":"Back")</a></div><section class="panel"><div class="detail-grid"><div><h2>@Model.Price.ToString("N0") đ</h2><p>@Model.Description</p><p><b>@(vi?"Thời gian":"Preparation time"):</b> @Model.PreparationTime min · @(Model.PreparationTime<=15?(vi?"Nhanh":"Quick"):(vi?"Thông thường":"Regular"))</p><p><b>@(vi?"Trạng thái":"Status"):</b> @(Model.IsAvailable?(vi?"Đang bán":"Available"):(vi?"Ngừng bán":"Unavailable"))</p><a class="btn primary" asp-action="Edit" asp-route-id="@Model.Id">@(vi?"Sửa món":"Edit dish")</a></div></div></section><h2>@(vi?"Hình ảnh món ăn":"Dish images")</h2><div class="image-grid">@foreach(var img in Model.Images){<div class="image-card"><img src="@img.ImageUrl" alt="Dish image"/><div class="image-meta">@(img.IsThumbnail?(vi?"Ảnh đại diện":"Thumbnail"):"Image")</div><div class="image-actions">@if(!img.IsThumbnail){<form asp-action="SetThumbnail" method="post"><input type="hidden" name="id" value="@img.Id"/><button class="btn" type="submit">@(vi?"Đặt làm đại diện":"Set thumbnail")</button></form>}<form asp-action="DeleteImage" method="post" onsubmit="return confirm('Delete this image?')"><input type="hidden" name="id" value="@img.Id"/><button class="btn danger" type="submit">@(vi?"Xóa ảnh":"Delete")</button></form></div></div>}</div>
@if(!Model.Images.Any()){<p class="empty">@(vi?"Món ăn chưa có ảnh.":"No images have been added yet.")</p>}<section class="panel"><h3>@(vi?"Thêm ảnh bằng URL":"Add image by URL")</h3><form asp-action="AddImage" method="post" class="image-form"><input type="hidden" name="dishId" value="@Model.Id"/><input name="imageUrl" type="url" required placeholder="https://example.com/image.jpg"/><label class="check"><input type="checkbox" name="isThumbnail" value="true"/> @(vi?"Đặt làm ảnh đại diện":"Set as thumbnail")</label><button class="btn primary" type="submit">@(vi?"Thêm ảnh":"Add image")</button></form></section>