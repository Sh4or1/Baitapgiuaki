@{ var vi=Context.Session.GetString("lang")=="vi"; var ret=Context.Request.Path+Context.Request.QueryString; }
<!DOCTYPE html><html lang="@(vi?"vi":"en")"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Food Manager</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body><header><a class="brand" asp-controller="Dishes" asp-action="Index">🍽 Food Manager</a><nav><a asp-controller="Dishes" asp-action="Index">@(vi?"Món ăn":"Dishes")</a><a asp-controller="Categories" asp-action="Index">@(vi?"Loại món":"Categories")</a><a href="@Url.Action("SetLanguage","Dishes",new{lang=vi?"en":"vi",returnUrl=ret})">@(vi?"English":"Tiếng Việt")</a></nav></header><main class="container">@if(TempData["Error"]!=null){<div class="alert">@TempData["Error"]</div>}@RenderBody()</main><footer>BIT220264 · ORM Midterm</footer></body></html>